# ===========================================
# Allocra - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===========================================
# Database (MongoDB Atlas)
# ===========================================
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/allocra?retryWrites=true&w=majority"

# ===========================================
# Application
# ===========================================
NEXT_PUBLIC_APP_NAME="Allocra"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ===========================================
# Authentication (Future Implementation)
# ===========================================
# NEXTAUTH_SECRET="your-secret-key-here"
# NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# Stock Data Provider
# ===========================================
# Supported: "alphavantage", "finnhub", "polygon", "mock"
STOCK_DATA_PROVIDER="mock"

# Alpha Vantage (https://www.alphavantage.co/)
# ALPHA_VANTAGE_API_KEY="your-alpha-vantage-key"

# Finnhub (https://finnhub.io/)
# FINNHUB_API_KEY="your-finnhub-key"

# Polygon.io (https://polygon.io/)
# POLYGON_API_KEY="your-polygon-key"

# ===========================================
# Email Service (Notifications)
# ===========================================
# Supported: "brevo", "resend", "mock"
EMAIL_PROVIDER="mock"

# Brevo (formerly Sendinblue) - https://www.brevo.com/
# BREVO_API_KEY="your-brevo-api-key"
# BREVO_SENDER_EMAIL="noreply@allocra.com"
# BREVO_SENDER_NAME="Allocra"

# Resend (https://resend.com/)
# RESEND_API_KEY="re_your_resend_key"
# RESEND_SENDER_EMAIL="noreply@allocra.com"

# ===========================================
# Cron/Scheduled Jobs
# ===========================================
# Secret for authenticating cron job requests (Vercel Cron)
CRON_SECRET="your-cron-secret-key"

# ===========================================
# Feature Flags
# ===========================================
ENABLE_EMAIL_NOTIFICATIONS="false"
ENABLE_PRICE_ALERTS="true"
ENABLE_TIME_TRIGGERS="true"

# ===========================================
# Rate Limiting
# ===========================================
# API_RATE_LIMIT_PER_MINUTE="60"
# STOCK_FETCH_INTERVAL_SECONDS="60"
